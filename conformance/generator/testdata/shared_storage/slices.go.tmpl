func Test$NAME(t *testing.T) {
	values := []string{$VALUES}
	for _, x := range values {
		for _, y := range values {
			for _, tail := range []string{",\"C\":0}", ", \"C\":0}", ",\"A\":[null]}", ",\"\\u0043\":0}", ",\"D\":{ }}"} {
				for state := 0; state < 4; state++ {
					for _, mode := range []string{"copy", "borrow", "poolcopy", "poolborrow"} {
						makeValue := func() ($NAME, []$ELEM) {
							a := []$ELEM{$SEED}
							switch state {
							case 0:
								return $NAME{}, a
							case 1:
								return $NAME{A: a[:1:1], B: a[:1:1]}, a
							case 2:
								return $NAME{A: a[:1], B: a[1:2]}, a
							default:
								return $NAME{A: a[:1], B: []$ELEM{$SEED}}, a
							}
						}
						got, a := makeValue()
						want, b := makeValue()
						doc := []byte("{\"A\":" + x + ",\"B\":" + y + tail)
						original := string(doc)
						var err error
						var d $NAMEDecoder
						switch mode {
						case "copy":
							err = got.UnmarshalZJSON(doc)
						case "borrow":
							err = got.UnmarshalZJSONBorrow(doc)
						case "poolcopy":
							want = $NAME{}
							err = d.Decode(doc, &got)
						case "poolborrow":
							want = $NAME{}
							err = d.DecodeBorrow(doc, &got)
						}
						if string(doc) != original {
							t.Fatal("decoder mutated input")
						}
						stdErr := json.Unmarshal([]byte(original), &want)
						if err != nil || stdErr != nil || !reflect.DeepEqual(got, want) || !reflect.DeepEqual(a, b) {
							t.Fatalf("shared storage state=%d mode=%s %s got=%+v/%v want=%+v/%v errors=%v/%v", state, mode, doc, got, a, want, b, err, stdErr)
						}
						// The same guards must recurse through a value-typed child struct.
						gv, ga := makeValue()
						wv, wa := makeValue()
						g, w := Outer$NAME{Child: gv}, Outer$NAME{Child: wv}
						nested := append(append([]byte("{\"Child\":"), doc...), '}')
						nestedOriginal := string(nested)
						if err := g.UnmarshalZJSON(nested); err != nil {
							t.Fatal(err)
						}
						if string(nested) != nestedOriginal {
							t.Fatal("decoder mutated nested input")
						}
						if err := json.Unmarshal([]byte(nestedOriginal), &w); err != nil {
							t.Fatal(err)
						}
						if !reflect.DeepEqual(g, w) || !reflect.DeepEqual(ga, wa) {
							t.Fatalf("shared storage nested %s", nested)
						}
					}
				}
			}
		}
	}
	// A conservative reuse guard must not disable the fresh-target fast path.
	var fresh $NAME
	l := zj.NewLexer([]byte("{\"A\":[],\"B\":[],\"C\":0}"), false)
	if !zjDecodeOrdered_$NAME(&l, &fresh, &zjArena$NAME{}) || l.Err() != nil {
		t.Fatal("fresh ordered path disabled", l.Err())
	}
}
